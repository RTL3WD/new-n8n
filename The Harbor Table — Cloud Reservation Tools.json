    {
      "id": "aaba44a9-6a2d-475a-84b0-86706f6f51b1",
      "name": "Decide Reservation Operation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        128
      ],
      "parameters": {
        "jsCode": "const req = $('Normalize Tool Request').first().json;\nconst settings = Object.fromEntries($('Load Demo Settings').all().filter(i=>i.json.key).map(i=>[i.json.key,i.json.value]));\nconst rows = $input.all().map(i=>i.json).filter(x=>x.reservation_id);\nconst slotRows = $('Load Harbor Slots').all().map(i=>i.json).filter(x=>x.slot_time);\nconst tz = settings.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\nconst today = now.toISODate();\nconst str = v => String(v ?? '').trim();\nconst normCode = v => str(v).toUpperCase().replace(/[^A-Z0-9]/g,'');\nconst normName = v => str(v).toLowerCase().replace(/[^a-z0-9]/g,'');\nconst phone = v => { let s=str(v).replace(/\\D/g,''); return s.length===11&&s.startsWith('1')?s.slice(1):s; };\nconst minutes = t => Number(t.slice(0,2))*60+Number(t.slice(3));\nconst hm = m => String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');\nconst uid = prefix => prefix+Date.now().toString(36).toUpperCase()+Math.random().toString(36).slice(2,7).toUpperCase();\nconst action=req.action;\nconst name=str(req.guest_name||req.name||req.caller_name);\nconst tel=phone(req.phone||req.caller_phone||req.phone_number);\nconst code=normCode(req.confirmation_code||req.reservation_id);\nlet result={status:'success',data:{},message:''}, operation='none', row=null, row_id=null;\nconst done=(data,message,op='none',record=null,id=null)=>[{json:{result:{status:'success',data,message},operation:op,row:record,row_id:id,settings,request:req}}];\nconst fail=(reason,message,extra={})=>done({status:reason,...extra},message);\nconst publicRow=x=>({confirmation_code:x.reservation_id,reservation_id:x.reservation_id,guest_name:x.guest_name,phone:x.phone,date:x.res_date,time:x.res_time,party_size:Number(x.party_size),special_requests:x.special_requests||'',status:x.status});\nconst validDate=d=>/^\\d{4}-\\d{2}-\\d{2}$/.test(d)&&DateTime.fromISO(d,{zone:tz}).isValid;\nconst validTime=t=>/^([01]\\d|2[0-3]):[0-5]\\d$/.test(t);\nfunction availability(date,time,party,excludeId=null){\n if(!validDate(date)) return {available:false,status:'invalid_date',alternatives:[],message:'What date would you like, including the month and day?'};\n if(date<today||date>now.plus({days:Number(settings.booking_window_days||30)}).toISODate()) return {available:false,status:'invalid_date',alternatives:[],message:'Reservations must be from today through thirty days ahead.'};\n if(!Number.isInteger(party)||party<1||party>Number(settings.max_party_size||8)) return {available:false,status:party>8?'callback_required':'invalid_party_size',alternatives:[],message:party>8?'Our events team handles parties of nine or more. May we arrange a callback?':'How many guests will be joining you?'};\n if(!validTime(time)) return {available:false,status:'invalid_time',alternatives:[],message:'What time would you like?'};\n const day=DateTime.fromISO(date,{zone:tz}).weekday;\n const windows=JSON.parse(settings.hours_json)[day]||[];\n const slots=[];\n for(const window of windows) for(let m=minutes(window[0]);m<=minutes(window[1])-60;m+=30){\n  const t=hm(m); const config=slotRows.find(s=>Number(s.day_index)===day&&s.slot_time===t);\n  const capacity=config?Number(config.max_covers):(day===5||day===6?30:24);\n  const used=rows.filter(x=>x.status==='confirmed'&&x.res_date===date&&x.res_time===t&&x.id!==excludeId).reduce((s,x)=>s+Number(x.party_size),0);\n  const future=DateTime.fromISO(date+'T'+t,{zone:tz})>now;\n  if(future&&capacity-used>=party) slots.push({date,time:t,party_size:party});\n }\n const available=slots.some(s=>s.time===time);\n const alternatives=slots.filter(s=>s.time!==time).sort((a,b)=>Math.abs(minutes(a.time)-minutes(time))-Math.abs(minutes(b.time)-minutes(time))).slice(0,2);\n return {available,status:available?'available':'unavailable',date,time,party_size:party,alternatives,message:available?'That table is available.':windows.length?'That time is unavailable. Please offer one of the returned alternatives.':'We are closed on Mondays.'};\n}\nif(action==='check_availability') { const a=availability(str(req.date),str(req.time),Number(req.party_size)); return done(a,a.message); }\nif(action==='request_callback') {\n const request=str(req.request||req.reason||req.special_requests);\n if(!name||tel.length!==10||!request) return fail('missing_details','Please collect the guest name, ten digit phone number, and reason for the callback.');\n const callback={callback_id:uid('CB-'),guest_name:name,phone:tel,request,status:'pending'};\n return done({status:'recorded',callback_id:callback.callback_id},'Your callback request has been recorded.','callback',callback);\n}\nif(!['create_reservation','lookup_reservation','modify_reservation','cancel_reservation'].includes(action)) return fail('invalid_action','That tool action is not supported.');\nif(!name) return fail('missing_name','What name is the reservation under?');\nif(action==='create_reservation') {\n if(tel.length!==10) return fail('invalid_phone','What is the ten digit phone number for the reservation?');\n const date=str(req.date),time=str(req.time),party=Number(req.party_size);\n const same=rows.find(x=>x.status==='confirmed'&&x.phone===tel&&x.res_date===date&&x.res_time===time&&Number(x.party_size)===party&&normName(x.guest_name)===normName(name));\n if(same) return done({...publicRow(same),status:'confirmed',already_exists:true},'This reservation is already confirmed.');\n const a=availability(date,time,party); if(!a.available) return done(a,a.message);\n const record={reservation_id:uid('HT-'),guest_name:name,phone:tel,party_size:party,res_date:date,res_time:time,status:'confirmed',occasion:'',special_requests:str(req.special_requests),source:'Dograh cloud restaurant demo'};\n return done({...publicRow(record),status:'confirmed'},'Your reservation is confirmed. We hold tables for fifteen minutes.','insert',record);\n}\nif(!code&&tel.length!==10) return fail('missing_identifier','What is your confirmation code or the ten digit phone number used to book?');\nlet matches=rows.filter(x=>normName(x.guest_name)===normName(name)&&(code?normCode(x.reservation_id)===code:x.phone===tel));\nif(code&&tel.length===10) matches=matches.filter(x=>x.phone===tel);\nif(!code) matches=matches.filter(x=>x.status==='confirmed'&&x.res_date>=today);\nif(!matches.length) return done({found:false,status:'not_found'},'No matching reservation was found. Please check the name and confirmation code or phone number.');\nif(matches.length>1) return done({found:true,status:'multiple_matches',reservations:matches.map(publicRow)},'More than one reservation matches. Ask for the confirmation code.');\nconst target=matches[0];\nif(action==='lookup_reservation') return done({found:true,...publicRow(target)},'Reservation found.');\nif(action==='cancel_reservation'){\n if(target.status==='cancelled') return done({...publicRow(target),status:'cancelled',already_cancelled:true},'That reservation is already cancelled.');\n if(target.status!=='confirmed') return fail('not_confirmed','This reservation cannot be cancelled automatically. Please request a callback.');\n return done({...publicRow(target),status:'cancelled'},'Your reservation is cancelled. There is no cancellation fee.','update',{...target,status:'cancelled'},target.id);\n}\nif(target.status!=='confirmed') return fail('not_confirmed','This reservation is not active. Would you like a new reservation?');\nconst date=str(req.new_date||req.date||target.res_date),time=str(req.new_time||req.time||target.res_time);\nconst party=Number(req.new_party_size||req.party_size||target.party_size);\nconst a=availability(date,time,party,target.id); if(!a.available) return done(a,a.message);\nconst changed={...target,res_date:date,res_time:time,party_size:party,special_requests:req.special_requests===undefined?target.special_requests:str(req.special_requests)};\nconst same=changed.res_date===target.res_date&&changed.res_time===target.res_time&&changed.party_size===Number(target.party_size)&&changed.special_requests===target.special_requests;\nreturn done({...publicRow(changed),status:'modified',unchanged:same},'Your reservation has been updated.',same?'none':'update',changed,target.id);\n"
      }
    },
