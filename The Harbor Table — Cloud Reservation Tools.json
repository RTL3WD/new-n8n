        "jsCode": "const d=$('Decide Reservation Operation').first().json; const s=d.settings; const result=d.result; const jobs=[]; const row=d.row; const enabled=v=>String(v)==='true'; const e164=v=>{const x=String(v||'').replace(/\\D/g,'');return x.length===10?'+1'+x:(x.length===11&&x[0]==='1'?'+'+x:'');}; if(d.operation!=='none'&&row&&d.request.test_mode!==true){ const event=row.reservation_id||row.callback_id; if(d.operation!=='callback'&&enabled(s.guest_sms_enabled))jobs.push({event_id:event,kind:'guest_'+result.data.status,recipient:e164(row.phone),text:s.restaurant_name+': Reservation '+result.data.status+'. '+row.guest_name+', '+row.res_date+' at '+row.res_time+', '+row.party_size+' guests. Confirmation '+row.reservation_id+'.'+(result.data.status==='confirmed'?' Tables held for 15 minutes.':'')}); const staff=e164(s.staff_alert_phone); if(enabled(s.staff_alerts_enabled)&&staff)jobs.push({event_id:event,kind:'staff_'+result.data.status,recipient:staff,text:s.restaurant_name+' DEMO: '+(d.operation==='callback'?'Callback requested by '+row.guest_name+' ('+e164(row.phone)+'): '+row.request:result.data.status+' reservation '+event+' for '+row.guest_name+', '+row.res_date+' '+row.res_time+', '+row.party_size+' guests. Phone '+e164(row.phone))}); } return jobs.length?jobs.map(j=>({json:{...j,from:s.sms_from,skip:false}})):[{json:{skip:true,status:d.request.test_mode===true?'test_mode':!s.staff_alert_phone&&d.operation==='callback'?'staff_recipient_not_configured':'no_notification'}}];"
      }
    },
