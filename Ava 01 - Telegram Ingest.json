    {
      "parameters": {
        "jsCode": "// Decide what this Telegram update is: an owner button tap, an owner command, owner chatter,\n// a client message (including the owner in /testclient mode), or something to ignore.\nconst u = $('Telegram Update').first().json;\nconst s = $input.first().json;\nconst owner = String(s.owner_chat_id);\n\nif (u.callback_query) {\n  const cq = u.callback_query;\n  const fromOwner = String(cq.from?.id) === owner || String(cq.message?.chat?.id) === owner;\n  return [{ json: fromOwner\n    ? { kind: 'owner_tap', callback_data: cq.data ?? '', callback_query_id: cq.id }\n    : { kind: 'ignore', reason: 'callback from non-owner' } }];\n}\n\nconst msg = u.message;\nif (!msg || msg.chat?.type !== 'private') {\n  return [{ json: { kind: 'ignore', reason: 'not a private message' } }];\n}\n\nconst chat = String(msg.chat.id);\nconst text = (msg.text ?? msg.caption ?? '').trim();\nconst isOwner = chat === owner;\n\nif (isOwner && text.startsWith('/')) {\n  const [command, ...rest] = text.split(/\\s+/);\n  return [{ json: { kind: 'owner_command', chat, command, args: rest.join(' ') } }];\n}\nif (isOwner && !s.test_mode) {\n  return [{ json: { kind: 'owner_chat', chat } }];\n}\nif (!text) {\n  return [{ json: { kind: 'unsupported', chat } }];\n}\nif (!isOwner && text === '/start') {\n  // Telegram sends /start when someone opens the bot: treat it as a hello\n  return [{ json: { kind: 'client', chat, channel: 'telegram', sender_ref: chat,\n    sender_name: [msg.from?.first_name, msg.from?.last_name].filter(Boolean).join(' '),\n    text: 'Hi', external_id: String(msg.message_id) } }];\n}\nreturn [{ json: { kind: 'client', chat, channel: 'telegram', sender_ref: chat,\n  sender_name: [msg.from?.first_name, msg.from?.last_name].filter(Boolean).join(' '),\n  text, external_id: String(msg.message_id) } }];"
      },
