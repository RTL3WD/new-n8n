      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ava.setting('owner_chat_id') #>> '{}' AS owner_chat_id,\n       COALESCE((ava.setting('owner_test_mode') #>> '{}')::boolean, false) AS test_mode",
        "options": {}
      },
      "id": "29033ec3-b201-4760-8bfe-1e0529a655c2",
      "name": "Load Owner Settings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        288,
        576
      ],
      "credentials": {
        "postgres": {
