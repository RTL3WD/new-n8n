      "parameters": {
        "jsCode": "const s = {};\n$input.all().forEach(function (i) { if (i.json && i.json.key) s[i.json.key] = String(i.json.value === null || i.json.value === undefined ? '' : i.json.value).trim(); });\nconst on = s.live_transfer_enabled === 'true';\nconst num = (s.transfer_number || '').replace(/[ ()-]/g, '');\nconst valid = /^[+][1-9][0-9]{7,14}$/.test(num);\nif (on && valid) {\n  return [{ json: { response: { transfer_context: { destination: num, custom_message: 'Connecting you to our on-call technician now. Please stay on the line.' } } } }];\n}\nreturn [{ json: { response: { transfer_context: {}, live_transfer: false, reason: on ? 'transfer_number is missing or not in E.164 format' : 'live_transfer_enabled is false', message: 'Live transfer is not available right now. Tell the caller the on-call technician will call them back shortly.' } } }];"
      }
    },
