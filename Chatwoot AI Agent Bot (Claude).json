      "name": "Prepare Signature Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -920,
        352
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst headers = item.json.headers || {};\nconst timestamp = String(headers['x-chatwoot-timestamp'] || '');\nconst signature = String(headers['x-chatwoot-signature'] || '');\n\n// Chatwoot signs the exact raw bytes, so read the raw body (Webhook > Raw Body must be on)\nlet rawBody = '';\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  rawBody = buf.toString('utf8');\n} catch (e) {\n  rawBody = '';\n}\n\n// Reject anything signed more than 5 minutes ago (replay protection)\nconst now = Math.floor(Date.now() / 1000);\nconst timestampValid = /^\\d+$/.test(timestamp) && Math.abs(now - Number(timestamp)) <= 300;\n\nreturn [{\n  json: {\n    ...item.json,\n    signedPayload: `${timestamp}.${rawBody}`,\n    receivedSignature: signature,\n    timestampValid,\n    hasRawBody: rawBody.length > 0\n  }\n}];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
