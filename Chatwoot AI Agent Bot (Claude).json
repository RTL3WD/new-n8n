              {
                "name": "status",
                "value": "open"
              }
            ]
          },
          "options": {
            "allowUnauthorizedCerts": true
          }
        },
        "id": "a8f4728c-fe02-4aef-945e-174c316b52d9",
        "name": "handoff_to_human",
        "type": "n8n-nodes-base.httpRequestTool",
        "typeVersion": 4.5,
