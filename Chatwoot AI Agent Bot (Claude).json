        "id": "5fda6058-c922-428a-afad-105de16858dd",
        "name": "Only New Customer Messages (Bot-Owned)",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.3,
        "position": [
          512,
          352
        ]
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=Customer: {{ $json.contact_name }} ({{ $json.contact_email || \"no email\" }})\nInbox: {{ $json.inbox_name }}\nTime: {{ $now.toFormat(\"ccc, LLL d yyyy h:mm a\") }}\n\nCustomer message:\n{{ $json.content }}",
          "options": {
            "systemMessage": "You are the first-line support assistant for Automate St Pete, an automation and AI agency for small businesses. You are talking to a customer inside a Chatwoot inbox.\n\nRules:\n1. The customer ONLY sees what you send with the reply_to_customer tool. Always reply with it. Keep replies short (1-3 sentences), warm, and plain.\n2. On the first message of a conversation, call set_labels with the best fit: sales, support, billing, urgent or spam.\n3. Hand off to a human when: the customer asks for a person, is upset, asks about pricing/contracts/billing specifics, or you are not confident. To hand off: (a) add_private_note with a 2-3 line summary, (b) reply_to_customer saying a team member will follow up shortly, (c) handoff_to_human.\n4. Never invent prices, policies, or availability. If unsure, hand off.\n5. Do not mention that you are using tools.",
            "maxIterations": 8,
            "enableStreaming": false
          }
        },
        "id": "6c2f06da-d7d7-4aaa-b1cf-dd2edf5102c4",
        "name": "Chatwoot Support Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 3.1,
        "position": [
          1088,
          240
        ]
      },
      {
        "parameters": {
          "sessionIdType": "customKey",
          "sessionKey": "=chatwoot-{{ $(\"Normalize Event\").first().json.conversation_id }}",
          "contextWindowLength": 10
        },
        "id": "edd65ac0-cb21-4acd-ad09-3d5108916225",
        "name": "Conversation Memory",
        "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
        "typeVersion": 1.4,
        "position": [
          976,
          480
        ]
      },
      {
        "parameters": {
          "toolDescription": "Send a public reply to the customer in this Chatwoot conversation. This is the ONLY way the customer sees your answer.",
          "method": "POST",
          "url": "={{ $(\"Normalize Event\").first().json.chatwoot_url }}/api/v1/accounts/{{ $(\"Normalize Event\").first().json.account_id }}/conversations/{{ $(\"Normalize Event\").first().json.conversation_id }}/messages",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "content",
                "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters0_Value', 'The reply text to send to the customer. Plain, friendly, concise.') }}"
              },
              {
                "name": "message_type",
                "value": "outgoing"
              },
              {
                "name": "private",
                "value": "false"
              }
            ]
          },
          "options": {
            "allowUnauthorizedCerts": true
          }
        },
        "id": "630c69a0-5aa2-4728-ace2-9a8fda47ee8e",
        "name": "reply_to_customer",
        "type": "n8n-nodes-base.httpRequestTool",
        "typeVersion": 4.5,
        "position": [
          1104,
          480
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "MIcLT1hLaAc22sGU",
            "name": "Chatwoot Header Auth"
          }
        }
      },
      {
        "parameters": {
          "toolDescription": "Add an internal private note to the conversation. Only human agents see it, never the customer. Use it to summarize context before a handoff.",
          "method": "POST",
          "url": "={{ $(\"Normalize Event\").first().json.chatwoot_url }}/api/v1/accounts/{{ $(\"Normalize Event\").first().json.account_id }}/conversations/{{ $(\"Normalize Event\").first().json.conversation_id }}/messages",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "content",
                "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters0_Value', 'Internal note for the human team: who the customer is, what they want, what was already tried.') }}"
              },
              {
                "name": "message_type",
                "value": "outgoing"
              },
              {
                "name": "private",
                "value": "true"
              }
            ]
          },
          "options": {
            "allowUnauthorizedCerts": true
          }
        },
        "id": "e6a7c485-0ae4-49f7-a652-f36d9293c191",
        "name": "add_private_note",
        "type": "n8n-nodes-base.httpRequestTool",
        "typeVersion": 4.5,
        "position": [
          1232,
          480
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "MIcLT1hLaAc22sGU",
            "name": "Chatwoot Header Auth"
          }
        }
      },
      {
        "parameters": {
          "toolDescription": "Set the labels on this conversation. This REPLACES existing labels. Allowed labels: sales, support, billing, urgent, spam. Labels must already exist in Chatwoot.",
          "method": "POST",
          "url": "={{ $(\"Normalize Event\").first().json.chatwoot_url }}/api/v1/accounts/{{ $(\"Normalize Event\").first().json.account_id }}/conversations/{{ $(\"Normalize Event\").first().json.conversation_id }}/labels",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ labels: $fromAI(\"labels\", \"Comma-separated labels, e.g. sales,urgent\", \"string\").split(\",\").map(l => l.trim()).filter(Boolean) }) }}",
          "options": {
            "allowUnauthorizedCerts": true
          }
        },
        "id": "64f29ea7-5b37-4589-9852-b391569fe2fa",
        "name": "set_labels",
        "type": "n8n-nodes-base.httpRequestTool",
        "typeVersion": 4.5,
        "position": [
          1360,
          480
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "MIcLT1hLaAc22sGU",
            "name": "Chatwoot Header Auth"
          }
        }
      },
      {
        "parameters": {
          "toolDescription": "Hand the conversation to a human agent by setting its status to open. After this the bot stops replying. Call add_private_note first, and tell the customer a person will follow up.",
          "method": "POST",
          "url": "={{ $(\"Normalize Event\").first().json.chatwoot_url }}/api/v1/accounts/{{ $(\"Normalize Event\").first().json.account_id }}/conversations/{{ $(\"Normalize Event\").first().json.conversation_id }}/toggle_status",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
