        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT ava.create_booking_request(\n  $1::uuid, $2, $3::timestamptz, $4::timestamptz, $5, $6, $7, $8, $9, $10, $11,\n  COALESCE(NULLIF($12, ''), 'new'), NULLIF($13, '')::uuid, COALESCE(NULLIF($14, '')::boolean, false)\n) AS result",
          "options": {
            "queryReplacement": "={{ (() => { const r = $('Booking Request').first().json; return [ r.client_id, r.service ?? '', r.start, r.end, (r.call_format || 'meet').toLowerCase(), r.call_phone ?? '', r.topic ?? '', r.budget_text ?? '', r.timeline_text ?? '', r.notes ?? '', r.channel ?? 'telegram', r.kind ?? '', r.replaces_booking_id ?? '', String(r.urgent_words ?? false) ]; })() }}"
          }
        },
