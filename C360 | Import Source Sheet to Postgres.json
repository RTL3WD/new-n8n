        "query": "CREATE SCHEMA IF NOT EXISTS c360;\nCREATE TABLE IF NOT EXISTS c360.businesses (\n  record_key text PRIMARY KEY,\n  source_row int,\n  data jsonb NOT NULL,\n  c360_status text,\n  c360_researched_at timestamptz,\n  refresh_requested boolean NOT NULL DEFAULT false,\n  imported_at timestamptz NOT NULL DEFAULT now()\n);\nCREATE INDEX IF NOT EXISTS businesses_due_idx ON c360.businesses (source_row) WHERE c360_status IS NULL;\nCREATE INDEX IF NOT EXISTS businesses_refresh_idx ON c360.businesses (source_row) WHERE refresh_requested;\nSELECT 1 AS ok;",
