    {
      "id": "8442dd62-d7b0-44fb-a9db-e8fa7fa00927",
      "name": "Build Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const published = new Set($('Read Published').all().map(x => x.json.record_key).filter(Boolean));\nconst review = new Set($('Read Review').all().map(x => x.json.record_key).filter(Boolean));\nconst seen = new Map();\n$('Read Source Sheet').all().forEach((x, i) => {\n  const s = x.json;\n  if (!s.name) return;\n  const key = String(s.profile_url || s.sunbiz_document_number || [s.name, s.street, s.city_state_zip].join('|')).trim();\n  if (!key || seen.has(key)) return;\n  const { row_number, c360_refresh_request, ...data } = s;\n  seen.set(key, {\n    record_key: key,\n    source_row: Number(row_number || i + 2),\n    data,\n    c360_status: published.has(key) ? 'AUTO_PUBLISHED' : review.has(key) ? 'PENDING' : null,\n    refresh_requested: String(c360_refresh_request || '').trim().toUpperCase() === 'REFRESH'\n  });\n});\nconst rows = [...seen.values()];\nconst out = [];\nfor (let i = 0; i < rows.length; i += 500) out.push({ json: { batch: i / 500 + 1, count: Math.min(500, rows.length - i), payload: JSON.stringify(rows.slice(i, i + 500)) } });\nreturn out;"
      }
    },
    {
      "id": "676a2e71-3844-493a-a649-0990aa56c4fc",
      "name": "Upsert Batch",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO c360.businesses (record_key, source_row, data, c360_status, refresh_requested)\nSELECT r.record_key, r.source_row, r.data, r.c360_status, COALESCE(r.refresh_requested, false)\nFROM jsonb_to_recordset($1::jsonb) AS r(record_key text, source_row int, data jsonb, c360_status text, refresh_requested boolean)\nON CONFLICT (record_key) DO UPDATE SET\n  source_row = EXCLUDED.source_row,\n  data = EXCLUDED.data,\n  c360_status = COALESCE(c360.businesses.c360_status, EXCLUDED.c360_status),\n  refresh_requested = c360.businesses.refresh_requested OR EXCLUDED.refresh_requested\nRETURNING record_key;",
        "options": {
          "queryReplacement": "={{ [ $json.payload ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1RCl2NMd9YUu88EJ",
          "name": "Coolify Postgres"
        }
      }
    },
    {
      "id": "4a6c1659-6b08-415d-8d72-dd94088619cb",
      "name": "Summary",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*) AS total,\n  count(*) FILTER (WHERE c360_status IS NULL) AS due,\n  count(*) FILTER (WHERE c360_status = 'AUTO_PUBLISHED') AS published,\n  count(*) FILTER (WHERE c360_status = 'PENDING') AS in_review,\n  count(*) FILTER (WHERE refresh_requested) AS refresh_requested\nFROM c360.businesses;",
        "options": {}
      },
