      {
        "id": "367f7141-ac29-46ef-89b8-08db1d601ffa",
        "name": "Build Sheet Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          0
        ],
        "parameters": {
          "jsCode": "const COLS = ['email','domain','status','bucket','is_catch_all','is_deliverable','mx_accepts_mail','purpose','source','index_row','business','checked_at','detail'];\n// Prefix values Sheets would treat as formulas\nconst safe = (v) => {\n  if (v === null || v === undefined) return '';\n  if (typeof v === 'boolean' || typeof v === 'number') return v;\n  const s = typeof v === 'object' ? JSON.stringify(v) : String(v);\n  return /^[=+@-]/.test(s) ? \"'\" + s : s;\n};\nconst fmt = (d) => {\n  if (!d) return '';\n  const js = new Date(d);\n  if (isNaN(js)) return String(d);\n  return DateTime.fromJSDate(js).setZone('America/New_York').toFormat('yyyy-MM-dd HH:mm:ss');\n};\nconst rows = $input.all().map(i => i.json).filter(x => x && x.email);\nrows.sort((a, b) => new Date(b.checked_at || 0) - new Date(a.checked_at || 0));\nconst values = [COLS, ...rows.map(r => COLS.map(c => c === 'checked_at' ? fmt(r[c]) : safe(r[c])))];\nreturn [{ json: { values, rowCount: rows.length } }];"
        }
      },
