      "parameters": {
        "jsCode": "const vr=$json.valueRanges||[];const out={};const dom=u=>String(u||'').toLowerCase().replace(/^https?:\\/\\//,'').split('/')[0].replace(/^www\\./,'');const idx=vr[0].values;const idxDomains=new Set(idx.slice(1).map(r=>dom(r[4])).filter(Boolean));const idxNames=new Set(idx.slice(1).map(r=>String(r[2]||'').toLowerCase().trim()));for(const r of vr.slice(1)){const v=r.values||[];const h=v[0]||[];const wi=h.findIndex(x=>/^website$/i.test(x));const ni=h.findIndex(x=>/^(name|business_name|business)$/i.test(x));const hits=v.filter(row=>row.join(' ').toLowerCase().match(/1000north|elshimy/));const domMatch=wi>=0?v.slice(1).filter(row=>idxDomains.has(dom(row[wi]))).length:null;const nameMatch=ni>=0?v.slice(1).filter(row=>idxNames.has(String(row[ni]||'').toLowerCase().trim())).length:null;out[r.range]={rows:v.length,headers:h,row2:(v[1]||[]).map(c=>String(c).slice(0,150)),hits:hits.map(x=>x.map(c=>String(c).slice(0,600))),domMatch,nameMatch};}\nconst sheetRowCheck=idx.slice(1,8).map(r=>({b:r[1],biz:r[2]}));out.sheetRowCheck=sheetRowCheck;out.idxBlankB=idx.slice(1).filter(r=>!r[1]).length;out.idxWithEmail=idx.slice(1).filter(r=>r[6]).length;out.idxStatus=[...new Set(idx.slice(1).map(r=>String(r[12]).split(':')[0]))];out.idxHasWebsite=idx.slice(1).filter(r=>r[4]).length;out.idxReady=idx.slice(1).filter(r=>/^ready/.test(r[12]||'')).length;return [{json:out}];"
      }
