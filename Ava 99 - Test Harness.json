    {
      "id": "552b7221-5a97-44c8-b2cd-1b771ba4f14d",
      "name": "Inspect Booking Timeline",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        1200
      ],
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "WITH b AS (\n  SELECT bk.* FROM ava.bookings bk JOIN ava.clients c ON c.id = bk.client_id\n  WHERE c.email = 'lordrobert92@gmail.com' ORDER BY bk.created_at DESC LIMIT 1\n), ev AS (\n  SELECT m.created_at AS at, 'message ' || m.direction || ' (' || m.author || ')' AS event, left(m.body, 160) AS detail\n  FROM ava.messages m, b\n  WHERE m.client_id = b.client_id AND m.created_at BETWEEN b.requested_at - interval '1 minute' AND COALESCE(b.decided_at, now()) + interval '1 minute'\n  UNION ALL\n  SELECT a.created_at, 'owner alert created (' || a.kind || ', ' || a.status || ')', '' FROM ava.owner_alerts a, b WHERE a.booking_id = b.id\n  UNION ALL\n  SELECT a.sent_at, 'owner alert SENT to Telegram (' || a.kind || ')', 'telegram msg ' || a.telegram_message_id FROM ava.owner_alerts a, b WHERE a.booking_id = b.id AND a.sent_at IS NOT NULL\n  UNION ALL\n  SELECT b.requested_at, 'booking row created (' || b.kind || ', ' || b.status || ')', '' FROM b\n)\nSELECT to_char(at AT TIME ZONE 'America/New_York', 'HH24:MI:SS.MS') AS time_et, event, detail FROM ev ORDER BY at"
      },
      "credentials": {
        "postgres": {
          "id": "1RCl2NMd9YUu88EJ",
          "name": "Coolify Postgres"
        }
      },
