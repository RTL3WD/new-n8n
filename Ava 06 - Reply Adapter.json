        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO ava.messages (client_id, channel, direction, author, sender_ref, external_id, thread_ref, body)\nVALUES (NULLIF($1, '')::uuid, $2, 'out', COALESCE(NULLIF($3, ''), 'ava'), $4, NULLIF($5, ''), NULLIF($6, ''), $7)\nRETURNING id AS message_log_id, external_id, thread_ref",
          "options": {
            "queryReplacement": "={{ [ $('Reply Request').first().json.client_id ?? '', $('Reply Request').first().json.channel, $('Reply Request').first().json.author ?? '', $('Reply Request').first().json.recipient, $json.external_id ?? '', $json.thread_ref ?? '', $('Reply Request').first().json.text ] }}"
          }
        },
