    {
      "id": "01bfc4df-e6f0-406a-ab2e-a09fb7167168",
      "name": "Format Busy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "// Google free/busy raw response: { calendars: { <id>: { busy: [{start,end}], errors? } } }\nconst raw = $input.first()?.json ?? {};\nconst cals = raw.calendars ?? {};\nconst busy = [];\nconst errors = [];\nfor (const [id, cal] of Object.entries(cals)) {\n  for (const b of cal.busy ?? []) busy.push({ start: b.start, end: b.end });\n  if (cal.errors?.length) errors.push({ id, errors: cal.errors });\n}\nreturn [{ json: { ok: errors.length === 0, operation: 'get_busy', busy, errors, raw_keys: Object.keys(raw) } }];"
      }
    },
